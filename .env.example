# ===== Bắt buộc khi deploy =====

# Khóa ký cookie đăng nhập. Tạo một chuỗi ngẫu nhiên dài, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Postgres để lưu tài khoản và tiến độ. Lấy từ Neon / Supabase / Vercel Postgres (bản miễn phí đủ dùng).
# Bỏ trống khi chạy trên máy: app sẽ tự lưu vào file .data/db.json (CHỈ dùng để chạy thử).
DATABASE_URL=

# ===== Tùy chọn =====

# Tên đăng nhập của giáo viên, nhiều tên cách nhau bằng dấu phẩy.
# Tài khoản trong danh sách này mới xem được trang /gv. Không khai thì mặc định là "giaovien".
# Lưu ý: tên đăng nhập phải từ 3 ký tự trở lên.
TEACHER_USERNAMES=giaovien
